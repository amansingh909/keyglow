[Unit]
Description=Keyglow keyboard lighting
# Start once the OpenRazer daemon is on the bus, when it is installed. Keyglow runs without it.
After=openrazer-daemon.service

[Service]
Type=simple
ExecStart=%h/.local/bin/keyglowd
Restart=on-failure
RestartSec=3
Nice=10
CPUQuota=15%
MemoryMax=64M

[Install]
WantedBy=default.target
